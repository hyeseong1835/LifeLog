{
  "type": "collector",
  "id": "win-media",
  "version": "1.0.0",
  "name": "미디어 재생 (Windows)",
  "min_host_version": 1,
  "runtimes": {
    "js": "main.js"
  },
  "capabilities": [
    {
      "id": "event:media",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "media",
      "kind": "span",
      "schema_version": 1,
      "columns": {
        "app": "text",
        "title": "text",
        "artist": "text",
        "album": "text"
      },
      "label": "title",
      "identity": [
        "app",
        "title"
      ]
    }
  ]
}