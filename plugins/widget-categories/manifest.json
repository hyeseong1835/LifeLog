{
  "type": "renderer",
  "id": "widget-categories",
  "version": "1.4.1",
  "name": "분류별 시간",
  "min_host_version": 1,
  "platforms": [
    "windows",
    "android"
  ],
  "runtimes": {
    "webview": "index.html"
  },
  "slot": "card",
  "inputs": [
    "win-window/window@1",
    "win-afk/afk@1",
    "phone-app/app@1"
  ],
  "settings": [
    {
      "key": "devices",
      "type": "list",
      "default": [],
      "label": "포함할 기기 (비우면 전부)"
    },
    {
      "key": "limit",
      "type": "number",
      "default": 12,
      "label": "표시 개수"
    }
  ]
}
