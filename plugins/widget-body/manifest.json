{
  "type": "renderer",
  "id": "widget-body",
  "version": "1.0.0",
  "name": "체성분",
  "min_host_version": 1,
  "platforms": [
    "windows",
    "android"
  ],
  "runtimes": {
    "webview": "index.html"
  },
  "slot": "card",
  "inputs": [
    "health/point@1"
  ],
  "settings": [
    {
      "key": "device",
      "type": "string",
      "default": "",
      "label": "기기 id (비우면 전부)"
    },
    {
      "key": "days",
      "type": "number",
      "default": 90,
      "label": "보여 줄 기간(일)"
    }
  ]
}
