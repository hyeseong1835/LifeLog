{
  "type": "renderer",
  "id": "widget-top-apps",
  "version": "1.1.0",
  "name": "앱별 시간",
  "min_host_version": 1,
  "runtimes": {
    "webview": "index.html"
  },
  "slot": "card",
  "inputs": [
    "win-window/window@1",
    "win-afk/afk@1",
    "phone-app/app@1"
  ],
  "settings": [
    {
      "key": "source",
      "type": "enum",
      "options": [
        "both",
        "laptop",
        "phone"
      ],
      "default": "both",
      "label": "출처"
    },
    {
      "key": "limit",
      "type": "number",
      "default": 10,
      "label": "표시 개수"
    }
  ]
}
