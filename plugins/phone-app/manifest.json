{
  "type": "collector",
  "id": "phone-app",
  "version": "1.0.1",
  "name": "앱 사용",
  "min_host_version": 1,
  "platforms": [
    "android"
  ],
  "runtimes": {
    "js": "main.js"
  },
  "capabilities": [
    {
      "id": "read:usage",
      "required": true
    },
    {
      "id": "timer",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "app",
      "kind": "span",
      "schema_version": 1,
      "columns": {
        "package": "text"
      },
      "label": "package",
      "identity": [
        "package"
      ],
      "index": [
        "package"
      ]
    }
  ]
}
