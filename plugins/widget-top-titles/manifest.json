{
  "type": "renderer",
  "id": "widget-top-titles",
  "version": "1.1.0",
  "name": "창 제목별 시간",
  "min_host_version": 1,
  "runtimes": {
    "webview": "index.html"
  },
  "slot": "card",
  "inputs": [
    "win-window/window@1",
    "win-afk/afk@1"
  ],
  "settings": [
    {
      "key": "limit",
      "type": "number",
      "default": 15,
      "label": "표시 개수"
    },
    {
      "key": "app",
      "type": "string",
      "default": "",
      "label": "앱 필터(정규식, 비우면 전부)"
    }
  ]
}
