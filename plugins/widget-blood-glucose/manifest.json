{
  "type": "renderer",
  "id": "widget-blood-glucose",
  "version": "1.0.0",
  "name": "혈당",
  "min_host_version": 1,
  "platforms": [
    "windows",
    "android"
  ],
  "runtimes": {
    "webview": "index.html"
  },
  "slot": "card",
  "inputs": [
    "health/point@1"
  ],
  "settings": [
    {
      "key": "device",
      "type": "string",
      "default": "",
      "label": "기기 id (비우면 전부)"
    },
    {
      "key": "days",
      "type": "number",
      "default": 30,
      "label": "보여 줄 기간(일)"
    },
    {
      "key": "unit",
      "type": "enum",
      "options": [
        "mg/dL",
        "mmol/L"
      ],
      "default": "mg/dL",
      "label": "단위"
    }
  ]
}
