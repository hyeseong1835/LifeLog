{
  "type": "renderer",
  "id": "widget-category-tree",
  "version": "1.0.1",
  "name": "분류 트리",
  "min_host_version": 1,
  "platforms": [
    "windows",
    "android"
  ],
  "runtimes": {
    "webview": "index.html"
  },
  "slot": "card",
  "inputs": [
    "win-window/window@1",
    "win-afk/afk@1",
    "phone-app/app@1"
  ],
  "settings": [
    {
      "key": "devices",
      "type": "list",
      "default": [],
      "label": "포함할 기기 (비우면 전부)"
    },
    {
      "key": "percent",
      "type": "boolean",
      "default": false,
      "label": "처음부터 퍼센트로"
    },
    {
      "key": "apps",
      "type": "boolean",
      "default": true,
      "label": "펼치면 앱도 보이기"
    }
  ]
}
