{
  "type": "collector",
  "id": "vscode",
  "version": "1.0.0",
  "name": "VS Code 편집",
  "min_host_version": 1,
  "runtimes": { "js": "main.js" },
  "capabilities": [
    { "id": "file:read:%LOCALAPPDATA%/LifeLog/vscode", "required": true },
    { "id": "timer", "required": true }
  ],
  "outputs": [
    {
      "name": "editor",
      "kind": "span",
      "schema_version": 1,
      "columns": { "project": "text", "file": "text", "language": "text" },
      "label": "file",
      "identity": ["project", "file"],
      "index": ["project"]
    }
  ]
}
