<Window x:Class="LifeLog.Dashboard.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LifeLog" Width="1200" Height="800" Background="#111">
    <Grid>
        <wv2:WebView2 x:Name="Web" />
        <TextBlock x:Name="Status" Foreground="#ccc" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/>
    </Grid>
</Window>
