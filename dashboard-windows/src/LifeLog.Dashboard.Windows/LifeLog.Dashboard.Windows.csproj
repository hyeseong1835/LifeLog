<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>lifelog-dashboard</AssemblyName>
    <RootNamespace>LifeLog.Dashboard.Windows</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <ProjectReference Include="..\..\..\collector-windows\src\LifeLog.Core\LifeLog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="web\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\sdk\lifelog-sdk.js" Link="web\sdk.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\plugins\widget-*\**" LinkBase="bundled-plugins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
